[Unit]
Description=TikTok Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/tiktok-bot
ExecStart=/usr/bin/node /opt/tiktok-bot/index.js
Restart=always
RestartSec=5
# If yt-dlp isn't on PATH for this user, point at it explicitly:
# Environment=YTDLP_PATH=/usr/local/bin/yt-dlp
# Route TikTok through a proxy if the VPS IP gets blocked:
# Environment=HTTPS_PROXY=http://user:pass@host:port

[Install]
WantedBy=multi-user.target

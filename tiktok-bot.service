[Unit]
Description=TikTok Bot (Telegram + Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/opt/tiktok-bot
ExecStart=/usr/bin/node /opt/tiktok-bot/index.js
Restart=always
RestartSec=5
# Route tikwm requests through a proxy if needed:
# Environment=HTTPS_PROXY=http://user:pass@host:port

[Install]
WantedBy=multi-user.target

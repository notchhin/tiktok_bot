# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Discord — leave both blank to disable Discord.
# Create a bot at https://discord.com/developers/applications
# and enable the "Message Content" privileged intent.
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# The bot only reacts in this single channel (right-click channel -> Copy Channel ID).
DISCORD_CHANNEL_ID=000000000000000000

# Optional: override the TikTok download API (defaults to tikwm).
# TIKTOK_API_BASE=https://www.tikwm.com/api/

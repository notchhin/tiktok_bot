  GNU nano 8.7.1                                             .env
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
#COOKIES_FILE=/opt/tiktok-bot/cookies.txt
# Optional: point to an existing yt-dlp binary instead of letting yt-dlp-wrap download one.
YTDLP_PATH=/usr/local/bin/yt-dlp
DISCORD_BOT_TOKEN=

#The bot only reacts in this single channel (right-click channel -> Copy Channel ID).
DISCORD_CHANNEL_ID=


